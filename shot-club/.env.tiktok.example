# TikTok API Credentials
# Get these from https://developer.tiktok.com
TIKTOK_ACCESS_TOKEN=your_access_token_here

# Optional: For token refresh (requires unaudited app credentials)
TIKTOK_REFRESH_TOKEN=optional_refresh_token
TIKTOK_CLIENT_ID=optional_client_id
TIKTOK_CLIENT_SECRET=optional_client_secret

# Supabase (for fetching game data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Card rendering endpoint (defaults to https://boxscorecard.app)
RENDER_CARD_URL=https://boxscorecard.app
