{
  "name": "shot-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-trackers.mjs && node scripts/generate-sitemap.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.js",
    "preview": "vite preview",
    "tiktok:produce": "node agents/tiktok-producer.mjs",
    "tiktok:analyze": "node agents/tiktok-analyst.mjs",
    "tiktok:setup": "chmod +x scripts/start-tiktok-agents.sh && ./scripts/start-tiktok-agents.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "posthog-js": "^1.410.3",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.40.0",
    "prerender-spa-plugin": "^3.4.0",
    "puppeteer": "^22.0.0",
    "vite": "^5.4.0"
  }
}
