# Disable Cloudflare Email Protection (prevents /cdn-cgi/l/email-protection in crawls)
/*
  Disable-Email-Protection: on

# Cache control for Cloudflare Pages

# Prerendered public pages: cache at edge for 1 day, revalidate browser copy every hour
/
  Cache-Control: public, max-age=3600, s-maxage=86400
/player
  Cache-Control: public, max-age=3600, s-maxage=86400
/coach
  Cache-Control: public, max-age=3600, s-maxage=86400
/for-clubs
  Cache-Control: public, max-age=3600, s-maxage=86400
/blog*
  Cache-Control: public, max-age=3600, s-maxage=86400
/challenges*
  Cache-Control: public, max-age=3600, s-maxage=86400
/1000-shot-rookie-challenge
  Cache-Control: public, max-age=3600, s-maxage=86400
/2500-shot-pro-challenge
  Cache-Control: public, max-age=3600, s-maxage=86400
/5000-shot-elite-challenge
  Cache-Control: public, max-age=3600, s-maxage=86400
/10000-shot-hall-of-famer-challenge
  Cache-Control: public, max-age=3600, s-maxage=86400
/privacy
  Cache-Control: public, max-age=86400, s-maxage=604800
/about
  Cache-Control: public, max-age=86400, s-maxage=604800

# Auth pages: only browser cache, no edge cache (contains user-specific data)
/start
  Cache-Control: no-cache, must-revalidate, private
/coach/start
  Cache-Control: no-cache, must-revalidate, private

# App shell: never cache (always revalidate)
/index.html
  Cache-Control: no-cache, must-revalidate, private

# Cache hashed assets forever (they have content hashes in filenames)
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Cache API responses briefly
/api/*
  Cache-Control: public, max-age=60

# Sitemap: short TTL. Cloudflare's default (s-maxage=604800) pinned this at the
# edge for a week, so a regenerated sitemap wouldn't reach Google for 7 days.
/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=300
