# Meta System Environment Variables
# Copy this file and fill in your actual values
# In production, set these as Cloudflare Pages environment variables

# ============================================
# Supabase (Required for all agents)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# Meta Graph API (Required for meta-publisher and meta-reels)
# ============================================

# Facebook/Instagram Graph API access token
# Get from: https://developers.facebook.com/apps > [Your App] > Tools > Access Token Debugger
# Permissions needed: instagram_basic, instagram_content_publish
# Make sure to generate a long-lived token (expires in ~60 days)
META_ACCESS_TOKEN=your-facebook-graph-api-token

# Facebook Page ID (where you want to post)
# Get from: https://facebook.com/[your-page] > About > Page ID
META_PAGE_ID=your-facebook-page-id

# Instagram Business Account ID
# Get from: Meta Business Suite > Instagram Account > Settings > Account Details
META_IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# ============================================
# Mailchimp (Required for mailchimp-sync agent)
# ============================================

# Mailchimp API Key
# Get from: https://mailchimp.com > Account > Extras > API Keys
# Format should be: key-us1 (where us1 is your server prefix)
MAILCHIMP_API_KEY=your-mailchimp-api-key

# Mailchimp Audience ID
# Get from: https://mailchimp.com > Audience > [Your List] > Settings > Audience name and defaults
MAILCHIMP_AUDIENCE_ID=your-mailchimp-audience-id

# ============================================
# TikTok (Optional for meta-reels agent)
# ============================================

# TikTok API Access Token
# Get from: https://developer.tiktok.com > My Apps > [Your App] > API Key/Secret
# Only needed if you want to automatically repost top TikToks to IG Reels
# If not set, meta-reels agent will skip TikTok fetch
TIKTOK_ACCESS_TOKEN=your-tiktok-api-token

# ============================================
# API Base URL (Optional)
# ============================================

# Base URL for render/card endpoint
# Default: http://localhost:5173/api
# Production: https://boxscorecard.app/api
# Used by meta-publisher to render trading cards
API_BASE_URL=http://localhost:5173/api

# ============================================
# Optional: Phone Number for Outreach
# ============================================

# Your phone number for outreach emails
# Replace in outreach-drafter.mjs if different
# Currently hardcoded as: 905-555-0123
OUTREACH_PHONE=905-555-0123
