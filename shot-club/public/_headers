# Cache control for Cloudflare Pages

# Never cache index.html - always validate with server
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Cache hashed assets forever (they have content hashes in filenames)
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Cache API responses briefly
/api/*
  Cache-Control: public, max-age=60

# Sitemap: short TTL. Cloudflare's default (s-maxage=604800) pinned this at the
# edge for a week, so a regenerated sitemap wouldn't reach Google for 7 days.
/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=300
