# Retired sitemaps — we collapsed to a single /sitemap.xml.
# Cloudflare Pages' _redirects does NOT support a 404 status, so without these
# the paths fall through to the SPA fallback below and return the homepage HTML
# with a 200 — the worst outcome for a URL Search Console still has on file.
# A 301 to the live sitemap is supported and unambiguous.
/sitemap-static.xml   /sitemap.xml   301
/sitemap-clubs.xml    /sitemap.xml   301

# Old two-tier challenge pages -> the matching page in the new four-tier
# (Rookie/Pro/Elite/Hall of Famer) system, carrying over search equity.
/5000-shot-challenge    /5000-shot-elite-challenge             301
/10000-shot-challenge   /10000-shot-hall-of-famer-challenge    301

# Old tracker short URLs -> current challenge landing pages
/1k-tracker             /1000-shot-rookie-challenge             301
/2_5k-tracker           /2500-shot-pro-challenge                301
/5k-tracker             /5000-shot-elite-challenge              301
/10k-tracker            /10000-shot-hall-of-famer-challenge     301

# SPA fallback — all client routes serve index.html
/* /index.html 200
